{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mhz://ship-builder/schema/hatches.schema.json",
  "title": "MHZ Ship Builder - hatches pack",
  "description": "Schema for data/shapes/hatches.json. Hatch families authored in Phase 1; their SDF geometry is not built until Phase 2 (see the required top-level '_note'). Enforced by tools/ship_validate_data.gd.",
  "type": "object",
  "required": ["_note"],
  "properties": {
    "_note": {
      "type": "string",
      "minLength": 20,
      "description": "Must explain that hatch geometry is authored but not yet built (Phase 1 bakes the all-open studio hull regardless of hatch selection)."
    }
  },
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "$ref": "#/$defs/hatch"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "param_range": {
      "type": "object",
      "required": ["min", "max", "default", "step"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "hatch": {
      "type": "object",
      "required": ["label", "description", "params"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "description": "What this hatch is, what it is for, what it looks like - real catalogue copy."
        },
        "params": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/param_range" }
        }
      }
    }
  }
}
